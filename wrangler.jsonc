{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-hub",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Production domains. www is canonical; the Worker redirects the bare
  // domain to www (see src/server.ts).
  "routes": [
    { "pattern": "www.andreamuti.com", "custom_domain": true },
    { "pattern": "andreamuti.com", "custom_domain": true }
  ],
  // No public copy on workers.dev, but every non-main branch still gets its
  // own preview URL for testing before merging.
  "workers_dev": false,
  "preview_urls": true,
  // Public configuration. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // MARKET_REPORTS_WEBHOOK_SECRET, GEMINI_API_KEY) are set on the Worker in the
  // Cloudflare dashboard and are never committed.
  "vars": {
    "SUPABASE_URL": "https://uxuxazeboaxcwxtkeiyj.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_csEj4buIrGqmboRtTRgxMA_uigM0nMq"
  },
  // Keep secrets and variables added in the dashboard on every deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
